# LLM：stub 无需 Key；后续可改为 openai / anthropic
LLM_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 可选可观测性
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 是否强制人工审核
REQUIRE_HITL=true
# 工具失败最大重试次数
MAX_TOOL_RETRIES=2
# P2：是否经 MCP 调用工具
USE_MCP=false
MCP_TIMEOUT_SECONDS=5
# 可选：共享工单库路径（Agent 与 MCP 子进程共用）
# TICKET_DB_PATH=.data/tickets.db
