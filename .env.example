# LLM：stub 无需 Key。anthropic / openai 有 Key 时由真实模型起草，分类仍用 stub
LLM_PROVIDER=stub
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
# OpenAI 兼容服务可改这里
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# 可选可观测性
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 是否强制人工审核
REQUIRE_HITL=true
# 工具失败最大重试次数
MAX_TOOL_RETRIES=2
# P2：是否经 MCP 调用工具
USE_MCP=false
MCP_TIMEOUT_SECONDS=5
# P5：暂停状态与追踪库；空则用 .data/runtime.db
# RUNTIME_DB_PATH=.data/runtime.db
TRACE_BUDGET_MS=2000
# P6：设置后知识库检索改调 citation-rag-agent。空则仍用关键词知识库
# RAG_BASE_URL=http://127.0.0.1:8001
RAG_TIMEOUT_SECONDS=10
