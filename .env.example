# LLM：stub 无需 Key。anthropic / openai 有 Key 时，分类、选工具和起草都走真实模型
LLM_PROVIDER=stub
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# 分类、调度、起草共用的上下文 token 上限。超出后先删最早的工具结果。
CONTEXT_TOKEN_BUDGET=1200
OPENAI_API_KEY=
# OpenAI 兼容服务可改这里
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# 可选可观测性
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 欧盟云 https://cloud.langfuse.com ；美国云 https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 是否强制人工审核
REQUIRE_HITL=true
# 审核密钥。留空时，待审列表、人审、重新送审和追踪都返回 401。
# REVIEW_API_KEY=
# 工具失败最大重试次数
MAX_TOOL_RETRIES=2
# 单进程内同时跑几张工单。POST /runs 会立刻返回，分类和起草在这些线程里进行。
RUN_WORKERS=2
# P2：是否经 MCP 调用工具
USE_MCP=false
MCP_TIMEOUT_SECONDS=5
# P5：暂停状态与追踪库；空则用 .data/runtime.db
# RUNTIME_DB_PATH=.data/runtime.db
TRACE_BUDGET_MS=2000
# P6：设置后知识库检索改调 citation-rag-agent。local 表示关键词知识库。
# 空字符串不会覆盖 .env 里已经写上的地址。
# RAG_BASE_URL=http://127.0.0.1:8001
# RAG_BASE_URL=local
RAG_TIMEOUT_SECONDS=10
