# LLM：stub 无需 Key。anthropic / openai 有 Key 时，分类、选工具和起草都走真实模型
LLM_PROVIDER=stub
# LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# 分类、调度、起草共用的上下文 token 上限。超出后先删最早的工具结果。
CONTEXT_TOKEN_BUDGET=1200
# 提示词销钉：current=v3，previous=v2。CI 只跑当前销钉。见 docs/PROMPTS.md
# PROMPT_PIN=current
OPENAI_API_KEY=
# OpenAI 兼容服务可改这里
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
# 可选可观测性
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 欧盟云 https://cloud.langfuse.com ；美国云 https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# 人审开关。true 时必须等人审；false 时服务端直接结案。请求体不能改这个值。
REQUIRE_HITL=true
# 本机入口默认只绑回环；容器内由 Dockerfile / compose 设 0.0.0.0，且经网关对外。见 docs/GATEWAY.md
# API_BIND_HOST=127.0.0.1
# API_BIND_PORT=8000
# P0.5 值班：ops 打 JSON 进集中日志；告警 Webhook / SMTP。见 docs/ONCALL.md
# OPS_LOG_JSON=false
# ALERT_WEBHOOK_URL=
# ALERT_COOLDOWN_SECONDS=60
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_USE_TLS=true
# 受理密钥。POST /runs 和 GET /runs/{trace_id} 的 X-API-Key。留空时这些接口返回 401。
# 生产用 Secret Manager / K8s secret 挂文件，优先读 *_FILE；见 docs/SECRETS.md。
# SERVICE_API_KEY=
# SERVICE_API_KEY_FILE=/run/secrets/service_api_key
# 轮换窗口：新旧两把都接受，调用方切完后清空 PREVIOUS。
# SERVICE_API_KEY_PREVIOUS=
# SERVICE_API_KEY_PREVIOUS_FILE=
# 审核引导密钥：只用于 POST /auth/review/token 换人员 JWT（本地 mint）。人审接口要 Bearer JWT。
# REVIEW_API_KEY=
# REVIEW_API_KEY_FILE=/run/secrets/review_api_key
# REVIEW_API_KEY_PREVIOUS=
# REVIEW_API_KEY_PREVIOUS_FILE=
# REVIEW_JWT_SECRET=
# REVIEW_JWT_TTL_SECONDS=3600
# 内测接真实 OIDC：设 ISSUER 后 mint 关闭，人审只接受 IdP Bearer。验签与 sub 口径不变。
# REVIEW_OIDC_ISSUER=https://idp.example.com
# REVIEW_OIDC_AUDIENCE=ticket-triage-review
# REVIEW_OIDC_JWKS_URL=https://idp.example.com/.well-known/jwks.json
# REVIEW_OIDC_TENANT_CLAIM=tid
# 可选：subject/body 静态加密口令（Fernet 派生）。空则明文 + 磁盘加密。
# DATA_AT_REST_KEY=
# 工具失败最大重试次数
MAX_TOOL_RETRIES=2
# 这个进程里同时执行几张工单。任务在 SQLite，进程退出后从最后完成的节点继续。
RUN_WORKERS=2
# 已受理但还没结束的单（含正在执行）的上限。超出后新工单返回 429 queue_full。
RUN_QUEUE_LIMIT=32
# 工单正文在 SQLite 的保留天数。过期删 tickets 行及同 ticket_id 的 runtime 留存。见 docs/DATA.md
TICKET_RETENTION_DAYS=90
# P2：是否经 MCP 调用工具
USE_MCP=false
MCP_TIMEOUT_SECONDS=5
# P5：暂停状态与追踪库；空则用 .data/runtime.db
# RUNTIME_DB_PATH=.data/runtime.db
TRACE_BUDGET_MS=2000
# P6：设置后知识库检索改调 citation-rag-agent。local 表示关键词知识库。
# 空字符串不会覆盖 .env 里已经写上的地址。
# RAG_BASE_URL=http://127.0.0.1:8001
# RAG_BASE_URL=local
RAG_TIMEOUT_SECONDS=10
# P3 集成：单租户 Webhook HMAC / 结案回调；多租户用 TENANTS_JSON。见 docs/P3_INTEGRATION.md
# WEBHOOK_SIGNING_SECRET=
# CLOSURE_CALLBACK_URL=http://127.0.0.1:9/callback
# IDEMPOTENCY_TTL_SECONDS=86400
# TENANTS_JSON=[{"tenant_id":"acme","service_api_key":"s1","review_api_key":"r1","webhook_secret":"wh1","callback_url":"http://127.0.0.1:9/cb","queue_limit":8}]
